# ── Base de datos ──────────────────────────────────────────────────────────────
# Para Docker (puerto 5433 en host para no colisionar con PostgreSQL local en 5432)
DATABASE_URL=postgresql+asyncpg://jobmail:jobmail@localhost:5433/jobmail_db

# ── Gmail API (configurar en Google Cloud Console) ─────────────────────────────
# 1. Ir a https://console.cloud.google.com
# 2. Crear proyecto → Habilitar Gmail API
# 3. Credenciales → OAuth2 → Aplicación web
# 4. Agregar URI de redirección: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ── LM Studio (servidor local) ─────────────────────────────────────────────────
# Asegúrate de tener el servidor activo en LM Studio antes de usar el chat
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_CHAT_MODEL=ibm/granite-4-h-tiny
LM_STUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# ── Scheduler ──────────────────────────────────────────────────────────────────
EMAIL_SYNC_INTERVAL_MINUTES=30

# ── App ────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
